rules_version = '2';

// My Finance — owner-only access.
//
// Every document a user owns lives under users/{uid}, so a single rule covers
// accounts, categories, transactions and transfers. Nothing is readable or
// writable without an authenticated request whose uid matches the path.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // All subcollections inherit the same restriction.
      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Anything outside a user's own tree is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

function isOwner(uid) {
  return request.auth != null && request.auth.uid == uid;
}
